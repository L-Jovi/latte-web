{
  "name": "latte-web",
  "private": true,
  "description": "Learn how the web works by building small versions of it: Promise/A+, mini React, a router, a bundler and more.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "fundamentals/typescript",
    "mechanisms/bundlers",
    "tooling/webpack",
    "tooling/grunt",
    "tooling/less",
    "tooling/handlebars",
    "tooling/gulp-typescript",
    "tooling/webpack-typescript",
    "examples/components",
    "mechanisms/router",
    "examples/react-classic",
    "examples/react-modern",
    "examples/rich-text-draft",
    "examples/rich-text-lexical",
    "examples/graphql-http",
    "examples/graphql/server",
    "examples/graphql/client",
    "examples/wasm",
    "examples/performance"
  ],
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/unit/*.test.js",
    "test:aplus": "node scripts/test-aplus.cjs",
    "test:browser": "playwright test",
    "build:pages": "node scripts/pages.mjs _site",
    "test:pages": "playwright test -c playwright.pages.config.js",
    "docs:generate": "node scripts/catalog.mjs",
    "check:docs": "node scripts/catalog.mjs --check && node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run test:aplus && npm run test:tooling && npm run test:apps && npm run test:api && npm run check:docs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:tooling": "node --test tests/tooling/*.test.js",
    "build:storybook": "npm run build:storybook -w @latte/components",
    "test:apps": "vitest run",
    "test:api": "node --import tsx --test tests/api/*.test.ts",
    "build:wasm": "npm run build:wasm -w @latte/wasm && npm run build -w @latte/wasm",
    "test:wasm": "LATTE_WASM=1 playwright test tests/browser/wasm.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.9",
    "promises-aplus-tests": "2.1.2",
    "vitest": "5.0.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@testing-library/dom": "10.4.1",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.1",
    "tsx": "4.23.15"
  },
  "overrides": {
    "promises-aplus-tests": {
      "mocha": "12.0.2",
      "underscore": "1.13.8"
    },
    "draft-js": {
      "immutable": "3.8.4"
    },
    "prisma": {
      "mysql2": "3.24.4"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "better-sqlite3@12.11.1": true,
    "@apollo/protobufjs@1.2.8": true
  }
}
